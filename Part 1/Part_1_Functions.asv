% rotX: Creates a Rotation matrix for rotations about the X-axis
%
% R = rotX(theta)
% Calculates R, given theta. R represents a rotation about the X-axis by
% theta radians
%
% R = A spatial rotation matrix (3x3) representing a rotation about the
% X-axis
%
% theta = Angle to rotate about the X-axis (in radians)
%
% Jake Stanley
% <Student number hidden until repository is made private>
% MEGN 544
% 9/29/2026
function R = rotX(theta)
R = [1  0           0;
     0  cos(theta)  -sin(theta);
     0  sin(theta)  cos(theta)];
end

% RotY: Creates a Rotation matrix for rotations about the Y-axis
%
% R = RotY(theta)
% Calculates R, given theta. R represents a rotation about the Y-axis by
% theta radians
%
% R = A spatial rotation matrix (3x3) representing a rotation about the
% Y-axis
%
% theta = Angle to rotate about the Y-axis (in radians)
%
% Jake Stanley
% <Student number hidden until repository is made private>
% MEGN 544
% 9/29/2026
function R = rotY(theta)
R = [cos(theta)     0   sin(theta);
     0              1   0;
     -sin(theta)    0   cos(theta)];
end

% RotZ: Creates a Rotation matrix for rotations about the Z-axis
%
% R = RotZ(theta)
% Calculates R, given theta. R represents a rotation about the Z-axis by
% theta radians
%
% R = A spatial rotation matrix (3x3) representing a rotation about the
% Z-axis
%
% theta = Angle to rotate about the Z-axis (in radians)
%
% Jake Stanley
% <Student number hidden until repository is made private>
% MEGN 544
% 9/29/2026
function R = rotZ(theta)
    R = [cos(theta)  -sin(theta)    0;
         sin(theta)  cos(theta)     0;
         0           0              1];
end

function R = rpy2Rot(roll, pitch, yaw)
    R = RotZ(yaw)*Roty(pitch)*RotX(roll)



